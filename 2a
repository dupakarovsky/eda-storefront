package shutdown_test

import (
	"context"
	"errors"
	"io"
	"log/slog"
	"net/http"
	"testing"
	"time"

	"github.com/dupakarovsky/eda-storefront/foundation/shutdown"
)

type newMockService struct {
	delay time.Duration
}

func (s *newMockService) Name() string {
	return "MOCKTEST"
}
func (s *newMockService) Run() error {
	time.Sleep(s.delay)
	return errors.New("simulated failure")
}
func (s *newMockService) Shutdown(ctx context.Context) error {
	return nil
}
func (s *newMockService) Close() error {
	return nil
}

func TestRun_WaitsForInFlightRequestBeforeReturning(t *testing.T) {

	const addr = "127.0.0.1:18080"
	const handlerDelay = 400 * time.Millisecond
	const triggerDealy = 100 * time.Millisecond

	// create a server mux
	mux := http.NewServeMux()

	// a slow handler to be called
	mux.HandleFunc("/slow", func(w http.ResponseWriter, r *http.Request) {
		time.Sleep(handlerDelay)
		w.WriteHeader(http.StatusOK)
	})

	// create a new server
	srv := &http.Server{
		Addr:    addr,
		Handler: mux,
	}

	// define a new logger
	logger := slog.New(slog.NewTextHandler(io.Discard, nil))

	// instantiate a httpService
	httpService := shutdown.NewHTTPService("SLOW_HTTP", logger, srv)

	// channel will receive the time the goroutine that httpService
	// is running inside has exited
	runReturned := make(chan time.Time, 1)

	// Run the service in a gououtine. The service has a 5 second shutdown window
	go func() {
		//
		_ = shutdown.Run(logger, 5*time.Second, httpService)
		runReturned <- time.Now()
	}()

	// wait for the server to be online before continuing
	time.Sleep(50 * time.Millisecond)

	// Server should be online now
	// we need to make an http Request to the /slow route
	// ------------------------------------------------------

	requestDone := make(chan time.Time, 1)

	// make the HTTP request to "/slow" in the goroutine
	go func() {
		// make the request and close the response body
		res, err := http.Get("http://" + addr + "/slow")
		if err != nil {
			t.Errorf("request failed: %v", err)
			requestDone <- time.Now()
		}
		defer res.Body.Close()

		// verify the StatusCode of the request
		if res.StatusCode != http.StatusOK {
			t.Errorf("expected 200; got %d", res.StatusCode)
		}
		// send the time the request took to complete
		// throught the requestDone chanel
		requestDone <- time.Now()
	}()

	// let's compare the time the request completed by the time the run finished
	// running.
	reqDoneAt := <-requestDone
	runDoneAt := <-runReturned

	if runDoneAt.Before(reqDoneAt) {
		t.Fatalf("Run() returned at %v, before the in-flight request finished at %v — shutdown did not wait for in-flight work",
			runDoneAt, reqDoneAt)
	}

	t.Logf("Run() returned %v after the in-flight request finished — graceful wait confirmed", runDoneAt.Sub(reqDoneAt))
}
